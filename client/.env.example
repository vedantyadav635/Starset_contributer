# ─────────────────────────────────────────────────────────────────────────────
# Starset — frontend (client) environment
#
# Copy this file to `.env` in the same folder and fill in real values:
#     cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to browser code through
# `import.meta.env`. Anything you put here ends up in the shipped bundle, so
# never place a service-role key, a database password or any other secret in
# this file — those belong in server/.env.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Starset backend, with no trailing slash.
# Leave empty to fall back to the hosted backend (see client/config/api.ts).
# Local backend example: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Supabase project URL — Project Settings → API → Project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — Project Settings → API → anon public.
# This key is safe in the browser; row level security is what protects the data.
# Do NOT use the service_role key here.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API key, injected at build time by vite.config.ts as
# process.env.API_KEY / process.env.GEMINI_API_KEY. Leave blank if unused.
GEMINI_API_KEY=
